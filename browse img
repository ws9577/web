# 批次指令 gallery-all（只做一次）
# 對每個含 gallery.js 的子資料夾，依序做三件事：縮大圖、做縮圖、更新 list.json。沒有 gallery.js 的資料夾不會被動到
cat > /usr/local/bin/gallery-all << 'EOF'
#!/bin/sh
# 用法：在上層資料夾執行 gallery-all [長邊px] [門檻] [品質]
find . -name gallery.js | while read -r g; do
  d=$(dirname "$g")
  echo "== $d"
  ( cd "$d" || exit
    exec </dev/null
    shrink "$@"
    mkthumbs
    ls | grep -iE '\.(jpg|jpeg|png|gif)$' | awk 'BEGIN{printf "["} {printf "%s\"%s\"", (NR>1?",":""), $0} END{print "]"}' > list.json
  )
done
echo "全部完成"
EOF
chmod +x /usr/local/bin/gallery-all

