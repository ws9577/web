# 新版 gallery.js（縮圖版） 202610
# 先存成一份範本：

document.addEventListener("DOMContentLoaded", function() {
    const gallery = document.getElementById('gallery');

    fetch('list.json')
        .then(response => response.json())
        .then(images => {
            images.sort((a, b) => a.localeCompare(b, undefined, {numeric: true}));
            images.forEach(function(image) {
                const div = document.createElement('div');
                div.classList.add('gallery-item', 'w3-col', 'm4');
                div.innerHTML = `
                    <a href="${image}" target="_blank">
                        <img src="thumbs/${image}" alt="" class="w3-hover-opacity" loading="lazy"
                             onerror="this.onerror=null;this.src='${image}'">
                    </a>
                `;
                gallery.appendChild(div);
            });
        })
        .catch(error => {
            console.error('Error loading image list:', error);
        });
});


