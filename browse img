#!/bin/sh
# 用法：在圖檔資料夾執行 mkthumbs [寬度px]，縮圖放 ./thumbs/
W=${1:-400}
IM=convert
command -v magick >/dev/null 2>&1 && IM=magick
mkdir -p thumbs
for f in *.jpg *.JPG *.jpeg *.JPEG *.png *.PNG; do
  [ -f "$f" ] || continue
  [ "thumbs/$f" -nt "$f" ] && continue   # 縮圖比原圖新就跳過
  echo "縮圖 $f"
  $IM "$f" -define jpeg:size=$((W*2))x$((W*2)) -thumbnail "${W}x>" -quality 75 -strip "thumbs/$f"
done
chmod +x /usr/local/bin/mkthumbs

