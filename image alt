# 檔名移除括號

for f in *\(*\)*; do
  new=$(printf '%s\n' "$f" | sed -E 's/ *\([^)]*\)//g')
  base="${new%.*}"; ext="${new##*.}"
  n=1
  while [ -e "$new" ]; do
    new="$base-$n.$ext"
    n=$((n+1))
  done
  mv -- "$f" "$new"
done
