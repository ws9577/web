# change size

cd /var/www/bonbon/img/libro/cook/fish # backup

for f in ../fish_original_backup/*.jpg ../fish_original_backup/*.JPG; do
  [ -f "$f" ] || continue
  echo "處理 ${f##*/} ..."
  convert "$f" -define jpeg:size=3200x3200 -resize '1600x1600>' -quality 80 -strip -interlace Plane "${f##*/}"
done
echo "完成"

